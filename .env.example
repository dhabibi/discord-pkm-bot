# Discord Bot Configuration
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Poke MCP Connector Configuration
# Set to 'true' to enable the Poke integration
POKE_ENABLED=false
# Your Poke API endpoint (e.g., https://api.poke.com/v1)
POKE_API_URL=your_poke_api_url_here
# Your Poke API key (from poke.com/settings/connections/integrations/new)
POKE_API_KEY=your_poke_api_key_here
# Webhook secret for validating incoming requests from Poke
POKE_WEBHOOK_SECRET=your_webhook_secret_here
# Port for the webhook server (default: 3000)
WEBHOOK_PORT=3000
