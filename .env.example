# Discord Bot Configuration
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Authorization Configuration
# Discord user ID of the authorized user (e.g., 123456789012345678)
# To get your user ID: Enable Developer Mode in Discord settings, right-click your username, and select "Copy User ID"
AUTHORIZED_USER_ID=your_user_id_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
